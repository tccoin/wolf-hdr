+void wlserver_mousemotion_absolute( double x, double y, uint32_t time )
+{
+	assert( wlserver_is_lock_held() );
+
+	// Nested wl_pointer motion is a mouse, not a touchscreen contact. Steam
+	// sets touch_click_mode=Passthrough in Gamepad UI; routing through
+	// wlserver_touchmotion then silently stops moving (and showing) the mouse.
+	// Keep the same output-to-focused-surface transform, independent of all
+	// touch modes, including Disabled. Relative game input is unchanged.
+	if ( wlserver.mouse_focus_surface )
+	{
+		double sx = ( x * g_nOutputWidth + focusedWindowOffsetX ) * focusedWindowScaleX;
+		double sy = ( y * g_nOutputHeight + focusedWindowOffsetY ) * focusedWindowScaleY;
+		wlserver_mousewarp( sx, sy, time, false );
+	}
+	bump_input_counter();
+}
