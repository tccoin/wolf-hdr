diff --git a/src/Backends/WaylandBackend.cpp b/src/Backends/WaylandBackend.cpp
--- a/src/Backends/WaylandBackend.cpp
+++ b/src/Backends/WaylandBackend.cpp
@@ -299,3 +299,4 @@
         bool m_bNeedsDecorCommit = false;
+        bool m_bConfigured = false;
         uint32_t m_uFractionalScale = 120;
         bool m_bHasRecievedScale = false;
@@ -1450,3 +1451,17 @@
     void CWaylandPlane::Present( std::optional<WaylandPlaneState> oState )
     {
+        if ( oState && m_pFrame && !m_bConfigured )
+        {
+            // A null-buffer commit unmaps an xdg_toplevel and invalidates
+            // its configure. Steam hides its updater before mapping the
+            // client, and hides the client when closed to the tray. Repeat
+            // the empty-commit/configure handshake before attaching again.
+            // Otherwise KWin disconnects the entire Gamescope client with
+            // "attached a buffer before configure event".
+            wl_surface_commit( m_pSurface );
+            wl_display_roundtrip( m_pBackend->GetDisplay() );
+            if ( !m_bConfigured )
+                return; // Configure callback schedules another repaint.
+        }
+
         {
@@ -1609,3 +1624,5 @@
             wl_surface_attach( m_pSurface, nullptr, 0, 0 );
             wl_surface_damage( m_pSurface, 0, 0, INT32_MAX, INT32_MAX );
+            if ( m_pFrame )
+                m_bConfigured = false;
         }
@@ -1742,3 +1759,4 @@
         CommitLibDecor( pConfiguration );
+        m_bConfigured = true;
 
         force_repaint();
