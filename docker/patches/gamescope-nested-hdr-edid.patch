         // TODO(JoshA): Need to resolve flInternalDisplayBrightness vs new connector hdrinfo mechanism.
 
+        // A nested compositor describes the current KDE output here. That is
+        // useful on a directly attached monitor, but a streamed virtual display
+        // has a separate physical/client peak contract. In particular, changing
+        // KDE calibration while Gamescope is running otherwise leaves Proton
+        // with a stale EDID (for example 1400 nits while Wolf and Moonlight both
+        // signal 1000). Prefer Wolf's global peak when it is valid; this variable
+        // is inherited by every Steam/Heroic Gamescope launcher.
+        uint32_t maxPeakLuminance = hdrInfo.uMaxContentLightLevel;
+        if ( const char *value = getenv( "WOLF_HDR_PEAK_NITS" ); value && *value )
+        {
+            char *end = nullptr;
+            errno = 0;
+            const long parsed = strtol( value, &end, 10 );
+            if ( errno == 0 && end != value && *end == '\0' && parsed >= 100 && parsed <= 10000 )
+            {
+                maxPeakLuminance = uint32_t( parsed );
+            }
+            else
+            {
+                edid_log.errorf( "Ignoring invalid WOLF_HDR_PEAK_NITS: %s", value );
+            }
+        }
+        const uint32_t maxFrameAverageLuminance =
+            std::min<uint32_t>( hdrInfo.uMaxFrameAverageLuminance, maxPeakLuminance );
+
         edid_log.infof("[edid] Patching HDR static metadata:\n"
