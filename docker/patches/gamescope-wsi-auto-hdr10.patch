+      const bool hdrColorspace = contentColorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT ||
+                                  contentColorSpace == VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT;
       const bool canBypass = gamescopeSurface->canBypassXWayland(hdrColorspace);
 
