+      // A D3D12 title can enable Advanced Color and select the HDR 10-bit
+      // format before Wine forwards its first SetColorSpace1 call. In an HDR
+      // Gamescope session this otherwise presents PQ values as sRGB until the
+      // user toggles HDR in the game. Upgrade only the HDR-capable 10-bit
+      // swapchain; 8-bit SDR swapchains and non-HDR sessions are unchanged.
+      const bool upgrade10BitSrgbToHdr = gamescopeSurface->shouldExposeHDR() &&
+        pCreateInfo->imageColorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR &&
+        (pCreateInfo->imageFormat == VK_FORMAT_A2B10G10R10_UNORM_PACK32 ||
+         pCreateInfo->imageFormat == VK_FORMAT_A2R10G10B10_UNORM_PACK32);
+      const VkColorSpaceKHR contentColorSpace = upgrade10BitSrgbToHdr
+        ? VK_COLOR_SPACE_HDR10_ST2084_EXT
+        : pCreateInfo->imageColorSpace;
+
+      if (upgrade10BitSrgbToHdr)
+        fprintf(stderr, "[Gamescope WSI] Upgrading HDR-session 10-bit sRGB swapchain to HDR10 PQ.\n");
+
       // Only the colorspaces we expose in s_ExtraHDRSurfaceFormat2s count as
       // HDR. Other non-sRGB colorspaces are still SDR content Wine can blit.
-      const bool hdrColorspace = pCreateInfo->imageColorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT ||
