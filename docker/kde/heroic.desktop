[Desktop Entry]
Type=Application
Name=Heroic Games Launcher
Comment=Open Heroic in a desktop window using your existing account and game library
Exec=/usr/local/bin/heroic %U
Icon=heroic
Terminal=false
Categories=Game;
MimeType=x-scheme-handler/heroic;
Actions=HDR;

[Desktop Action HDR]
Name=Heroic Fullscreen (HDR)
Exec=/usr/local/bin/heroic --wolf-hdr
