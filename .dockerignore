# Start by removing everything and add just the things we need
*

!src
!tests
!tests/**
!Cargo.toml
!cmake
!CMakeLists.txt
!.clang-format
!docker/gstreamer.control
!docker/nvcodec-rgb10-hdr-vui.patch
!docker/startup.sh
!docker/supervisord.conf
!docker/steam-wait-input.sh
!docker/steam-runtime-dirs-init.sh
!docker/steam-safe-user-init.sh
!docker/steam-uinput-init.sh
!docker/steam-wait-wayland.sh
!docker/cyberpunk-hdr-startup.sh
