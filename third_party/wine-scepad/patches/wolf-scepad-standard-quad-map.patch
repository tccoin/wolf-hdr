+        stream->map.map[0] = PA_CHANNEL_POSITION_FRONT_LEFT;
+        stream->map.map[1] = PA_CHANNEL_POSITION_FRONT_RIGHT;
+        stream->map.map[2] = PA_CHANNEL_POSITION_REAR_LEFT;
+        stream->map.map[3] = PA_CHANNEL_POSITION_REAR_RIGHT;
