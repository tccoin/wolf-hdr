+/* Wolf captures the ScePad rear-channel PCM from its named PulseAudio sink.
+ * A local PipeWire/ALSA endpoint bypasses the server entirely, so streamed
+ * sessions explicitly keep ScePad on PulseAudio even if a raw endpoint is
+ * discovered during startup or hotplug. */
+static BOOL force_wolf_scepad_pulse_route(void)
+{
+    const char *env = getenv("WOLF_SCEPAD_FORCE_PULSE");
+
+    return env && env[0] == '1' && !env[1];
+}
+
+static BOOL use_raw_dualsense_haptic_target(void)
+{
+    return use_pipewire_dualsense_haptic_target() && !force_wolf_scepad_pulse_route();
+}
