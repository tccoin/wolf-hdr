+/*
+ * CONTROL Resonant creates the public v0 object and then queries the v2
+ * interface.  v2 is a separate COM interface (rather than a v0 prefix), so
+ * returning the v0 vtable here corrupts the first call after QueryInterface.
+ * Keep both interface headers on the same device object and share its
+ * lifetime.  The v2 metadata is deliberately populated from the native HID
+ * collection below; this is not a Steam/XInput compatibility device.
+ */
+static HRESULT WINAPI game_input_device_v2_QueryInterface( IGameInputDevice_v2 *iface, REFIID iid, void **out )
+{
+    struct device *device = device_from_IGameInputDevice_v2( iface );
+
+    TRACE( "device %p, iid %s, out %p.\n", device, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IGameInputDevice_v2 ))
+    {
+        *out = &device->IGameInputDevice_v2_iface;
+        IGameInputDevice_v2_AddRef( &device->IGameInputDevice_v2_iface );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IGameInputDevice_v0 ) || IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        *out = &device->IGameInputDevice_v0_iface;
+        IGameInputDevice_v0_AddRef( &device->IGameInputDevice_v0_iface );
+        return S_OK;
+    }
+
+    *out = NULL;
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    return E_NOINTERFACE;
+}
