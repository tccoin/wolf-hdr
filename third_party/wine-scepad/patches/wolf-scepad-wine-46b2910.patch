+           device->status );
+    return S_OK;
+}
+
+static HRESULT WINAPI game_input_device_v2_GetHapticInfo( IGameInputDevice_v2 *iface, GameInputHapticInfo *info )
+{
+    static const WCHAR dualsense_haptic_endpoint[] =
+        L"alsa_output.usb-Sony_Interactive_Entertainment_Wireless_Controller-00.HiFi__Speaker__sink";
+    struct device *device = device_from_IGameInputDevice_v2( iface );
+
+    if (!info) return E_POINTER;
+    if (!(device->status & GameInputDeviceHapticInfoReady))
+        return GAMEINPUT_E_HAPTIC_INFO_NOT_FOUND;
+
+    memset( info, 0, sizeof(*info) );
+    /* WinePulse maps this stable public endpoint to Wolf's paired four-channel
+     * control_dualsense_audio sink. The two front channels are padding; Wolf
+     * forwards the rear pair, which are the controller's left/right haptics. */
+    lstrcpynW( info->audioEndpointId, dualsense_haptic_endpoint,
+               ARRAY_SIZE(info->audioEndpointId) );
+    info->locationCount = 4;
+    info->locations[0] = GAMEINPUT_HAPTIC_LOCATION_NONE;
+    info->locations[1] = GAMEINPUT_HAPTIC_LOCATION_NONE;
+    info->locations[2] = GAMEINPUT_HAPTIC_LOCATION_GRIP_LEFT;
+    info->locations[3] = GAMEINPUT_HAPTIC_LOCATION_GRIP_RIGHT;
+    TRACE( "device %p exposes haptic endpoint %s.\n",
+           device, debugstr_w( info->audioEndpointId ) );
+    return S_OK;
+}
