+static BOOL is_sony_hidraw_gamepad(const struct device_extension *ext)
+{
+    return ext->desc.is_hidraw && ext->desc.vid == 0x054c &&
+            (is_dualshock4_gamepad(ext->desc.vid, ext->desc.pid) ||
